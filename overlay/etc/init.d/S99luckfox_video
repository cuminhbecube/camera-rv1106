#!/bin/sh
#
# Start the Rockchip IPC service and the read-only Luckfox status monitor.
#
# Safety rules:
#   - Never modify /userdata/rkipc.ini here.
#   - Never delete existing recording directories.
#   - Never kill a healthy rkipc during a normal "start".
#   - Refuse to start recording when the SD mount/link layout is unsafe.
#

export LD_LIBRARY_PATH=/oem/usr/lib:/oem/lib:$LD_LIBRARY_PATH
export PATH=/oem/usr/bin:/oem/bin:$PATH

SD_MOUNT="/mnt/sdcard"
WEB_BIN="/oem/usr/bin/luckfox_web_config"
RKIPC_BIN="/oem/usr/bin/rkipc"
IQ_PATH="/oem/usr/share/iqfiles"

is_sd_mounted() {
    awk -v m="$SD_MOUNT" '$2 == m { found=1 } END { exit(found ? 0 : 1) }' /proc/mounts
}

ensure_safe_link() {
    link_path="$1"
    target_path="$2"

    mkdir -p "$target_path" || return 1

    if [ -L "$link_path" ]; then
        ln -sfn "$target_path" "$link_path"
        return $?
    fi

    if [ -e "$link_path" ]; then
        if [ -d "$link_path" ] && [ -z "$(ls -A "$link_path" 2>/dev/null)" ]; then
            rmdir "$link_path" || return 1
        else
            echo "WARNING: $link_path contains data; refusing to delete or replace it."
            echo "Move/recover that data manually, then run: $0 start"
            return 1
        fi
    fi

    ln -s "$target_path" "$link_path"
}

prepare_storage() {
    if ! is_sd_mounted; then
        echo "ERROR: $SD_MOUNT is not mounted; rkipc will not be started."
        return 1
    fi

    mkdir -p "$SD_MOUNT/recordings" "$SD_MOUNT/video1" "$SD_MOUNT/video2" || return 1
    chmod 775 "$SD_MOUNT/recordings" "$SD_MOUNT/video1" "$SD_MOUNT/video2" 2>/dev/null || true

    # recordings is enabled by default and must be safe.
    ensure_safe_link /userdata/recordings "$SD_MOUNT/recordings" || return 1

    # Secondary streams are normally disabled. Preserve any existing data instead
    # of forcing/deleting their directories.
    ensure_safe_link /userdata/video1 "$SD_MOUNT/video1" || true
    ensure_safe_link /userdata/video2 "$SD_MOUNT/video2" || true
    return 0
}

start_rkipc() {
    if pidof rkipc >/dev/null 2>&1; then
        echo "rkipc already running (PID $(pidof rkipc))"
        return 0
    fi

    if ! prepare_storage; then
        echo "rkipc start skipped for storage safety."
        return 1
    fi

    echo "Starting rkipc..."
    cd /oem || return 1
    "$RKIPC_BIN" -a "$IQ_PATH" >/tmp/rkipc.log 2>&1 &
    sleep 2

    if pidof rkipc >/dev/null 2>&1; then
        echo "rkipc started (PID $(pidof rkipc))"
        return 0
    fi

    echo "ERROR: rkipc failed to start; see /tmp/rkipc.log"
    return 1
}

start_web() {
    if [ ! -x "$WEB_BIN" ]; then
        echo "ERROR: $WEB_BIN not found or not executable"
        return 1
    fi

    if pidof luckfox_web_config >/dev/null 2>&1; then
        echo "luckfox_web_config already running (PID $(pidof luckfox_web_config))"
        return 0
    fi

    echo "Starting read-only web monitor..."
    "$WEB_BIN" >/tmp/luckfox_web_config.stdout 2>&1 &
    sleep 1

    if pidof luckfox_web_config >/dev/null 2>&1; then
        echo "luckfox_web_config started (PID $(pidof luckfox_web_config))"
        return 0
    fi

    echo "ERROR: luckfox_web_config failed to start"
    return 1
}

stop_web() {
    if pidof luckfox_web_config >/dev/null 2>&1; then
        killall luckfox_web_config 2>/dev/null || true
        sleep 1
    fi
}

case "$1" in
  start)
    # Give the kernel/udev/mount scripts a short chance to mount the SD card.
    retries=0
    while ! is_sd_mounted && [ "$retries" -lt 10 ]; do
        sleep 1
        retries=$((retries + 1))
    done

    start_rkipc || true
    start_web || exit 1
    ;;

  stop)
    # This init script owns the monitor lifecycle only. Do not kill rkipc here:
    # stopping the status UI must never interrupt RTSP/recording.
    stop_web
    ;;

  restart|reload)
    stop_web
    start_web
    ;;

  status)
    echo "=== Service Status ==="
    if pidof rkipc >/dev/null 2>&1; then
        echo "rkipc: RUNNING (PID $(pidof rkipc))"
    else
        echo "rkipc: STOPPED"
    fi

    if pidof luckfox_web_config >/dev/null 2>&1; then
        echo "luckfox_web_config: RUNNING (PID $(pidof luckfox_web_config))"
    else
        echo "luckfox_web_config: STOPPED"
    fi

    if is_sd_mounted; then
        echo "SD: MOUNTED at $SD_MOUNT"
    else
        echo "SD: NOT MOUNTED"
    fi
    ;;

  start-rkipc)
    # Recovery helper after inserting/fixing an SD card.
    start_rkipc
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|reload|status|start-rkipc}"
    exit 1
    ;;
esac

exit 0
